# Modelo de configuração do Sistema de Gerenciamento de Aulas.
# Copie para .env somente em uma instalação nova.
# Preencha SESSION_SECRET e INITIAL_SETUP_TOKEN antes de iniciar a aplicação.
# Não substitua um .env existente apenas para atualizar este exemplo.

# Ambiente de execução: development, test ou production.
NODE_ENV=development

# Acesso restrito a este computador.
HOST=127.0.0.1
PORT=3000

# Banco próprio desta instalação no MongoDB local.
MONGODB_URI=mongodb://127.0.0.1:27017/sistema_gerenciamento_aulas

# Segredo privado das sessões. Gere um valor diferente em cada instalação:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Cole o resultado depois de SESSION_SECRET= no seu .env.
SESSION_SECRET=

# Código privado para criar a primeira conta pela interface.
# Gere 64 caracteres hexadecimais, sem reutilizar o segredo de sessão:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Cole o resultado depois de INITIAL_SETUP_TOKEN= no seu .env.
# Após concluir o cadastro, esta linha pode ser removida do .env.
# Não deixe a linha com valor vazio: preencha ou remova a linha inteira.
INITIAL_SETUP_TOKEN=

# Nome, e-mail e senha serão escolhidos no primeiro cadastro.
# Nenhuma conta administrativa é fornecida neste exemplo.
# O e-mail de acesso à aplicação não realiza login na conta Google.

# Custo do bcrypt: número inteiro entre 10 e 15; recomendado: 12.
PASSWORD_HASH_ROUNDS=12

# Duração máxima da sessão autenticada, em horas.
SESSION_HOURS=8

# Use este endereço no navegador para o cadastro e o acesso local.
# Se mudar a porta, ajuste PORT e APP_ORIGIN juntos.
APP_ORIGIN=http://localhost:3000

# A instalação local não utiliza proxy reverso.
TRUST_PROXY=0
