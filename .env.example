# Ambiente de execução: development, test ou production.
NODE_ENV=development

# Interface e porta em que o servidor aceitará conexões.
HOST=0.0.0.0
PORT=3000

# Endereço do banco de dados.
# Este endereço aponta para a instalação local do MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/calendario_dionisio

# Segredo utilizado para proteger as futuras sessões.
# Nunca use este texto de exemplo em produção.
SESSION_SECRET=substitua-por-um-segredo-com-pelo-menos-32-caracteres

# Custo computacional utilizado pelo bcrypt.
# São aceitos números inteiros entre 10 e 15. O valor recomendado é 12.
PASSWORD_HASH_ROUNDS=12

# Conta administrativa inicial do professor.
# Os valores reais deverão existir apenas no arquivo .env.
# A senha deve possuir pelo menos 12 caracteres e no máximo 72 bytes em UTF-8.
ADMIN_NAME=Dionísio Pereira
ADMIN_EMAIL=dionisio@example.com
ADMIN_PASSWORD=substitua-por-uma-senha-forte

# Tempo máximo da sessão autenticada, em horas.
SESSION_HOURS=8

# Origem pública permitida para a aplicação.
APP_ORIGIN=http://localhost:3000

# Use 1 somente quando a hospedagem possuir proxy reverso configurado.
TRUST_PROXY=0